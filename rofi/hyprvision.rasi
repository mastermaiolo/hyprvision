/* ══════════════════════════════════════════════════════════════════════
   HyprVision · Tema Rofi
   Construído sobre o GlassTheme Rofi (@theme "glass")
   
   Compartilha 100% da anatomia, física de vidro e regras do sistema
   com o ecossistema (coherent-design / Hypr.AI).
   ══════════════════════════════════════════════════════════════════════ */

@theme "glass"

* {
    /* Fallback estático com acento azul do HyprVision (sem Noctalia/Caelestia) */
    bg3:        #55A3F2F2;
    sel:        #55A3F21F;
    chip-bg:    #55A3F224;
}

entry {
    placeholder: "pesquisar perfil...";
}

listview {
    /* Altura para comportar a lista de perfis do HyprVision */
    lines:      12;
}
